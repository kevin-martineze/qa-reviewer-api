# Copia este archivo a .env. Todo lo vacío es opcional en desarrollo.
NODE_ENV=development
PORT=3000

# `memory` levanta Mongo en memoria dentro del proceso (se pierde al detenerlo).
# Con `pnpm db` corriendo: mongodb://127.0.0.1:27017/qa_reviewer?replicaSet=rs0
MONGO_URI=mongodb://127.0.0.1:27017/qa_reviewer?replicaSet=rs0
# `demo` borra la base y carga la demo al arrancar (nunca en producción).
SEED=

PUBLIC_WEB_URL=http://localhost:5173
# Vacío = http://localhost:$PORT. Detrás de un proxy, la URL que ve el navegador.
PUBLIC_API_URL=
# Orígenes extra para CORS, separados por coma (por defecto, PUBLIC_WEB_URL).
CORS_ORIGINS=
SESSION_TTL_DAYS=7

# Capturas: `local` (disco, firmado con HMAC) o `s3` (AWS S3, MinIO, R2).
STORAGE_DRIVER=local
STORAGE_DIR=.data/storage
STORAGE_SECRET=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Correo: `log` (se escribe en consola) o `resend`.
MAIL_DRIVER=log
MAIL_FROM=QA Reviewer <no-reply@qa-reviewer.local>
RESEND_API_KEY=

# Integraciones (opcionales): sin token, el notificador se omite.
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
PLANE_API_URL=https://api.plane.so
PLANE_TOKEN=
PLANE_WORKSPACE=

OUTBOX_INTERVAL_MS=5000
JOBS_ENABLED=true
RETENTION_DAYS=90
