# /opt/qa-reviewer/.env en la instancia (permiso 600, dueño root). Nunca en el repo.
# MONGO_URI, NODE_ENV, PORT, LOG_FORMAT y PUBLIC_API_URL los fija docker-compose.prod.yml.

# Host público del API: Caddy saca el certificado para él.
API_HOST=api.184-73-227-93.sslip.io
# Imagen a desplegar (el workflow la fija por commit; por defecto, :latest).
API_IMAGE=ghcr.io/kevin-martineze/qa-reviewer-api:latest

PUBLIC_WEB_URL=https://qa-reviewer.vercel.app
CORS_ORIGINS=
SESSION_TTL_DAYS=7
MIN_SKILL_VERSION=0.1.0

# Capturas en S3 con el rol de la instancia: sin endpoint ni llaves.
STORAGE_DRIVER=s3
S3_BUCKET=qa-reviewer-captures-<cuenta>
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Respaldos (deploy/backup.sh).
BACKUP_BUCKET=qa-reviewer-backups-<cuenta>

MAIL_DRIVER=resend
MAIL_FROM=QA Reviewer <onboarding@resend.dev>
RESEND_API_KEY=

GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
PLANE_TOKEN=
PLANE_WORKSPACE=

JOBS_ENABLED=true
RETENTION_DAYS=90
